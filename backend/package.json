{
  "name": "battle-semantic-backend",
  "version": "1.0.0",
  "description": "Backend for Battle Semantic application using Supabase",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:clean": "npm run clean && npm run dev",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting not configured yet'",
    "format": "echo 'Formatting not configured yet'",
    "clean": "rm -rf dist",
    "test": "tsx tests/run-tests.ts",
    "test:fal": "tsx tests/fal-ai.test.ts",
    "test:message": "tsx tests/message-enhancement.test.ts",
    "test:demo": "tsx tests/message-demo.test.ts",
    "test:watch": "tsx watch tests/run-tests.ts",
    "prebuild": "npm run clean",
    "postbuild": "echo 'Build completed successfully'",
    "prestart": "npm run build"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@privy-io/server-auth": "^1.32.5",
    "@supabase/supabase-js": "^2.39.0",
    "@types/qrcode": "^1.5.5",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "supabase",
    "backend",
    "api",
    "typescript"
  ],
  "author": "",
  "license": "MIT"
}
